# NOTA:
# - `pnpm dev` lee `server/.env` al arrancar el backend
# - `pnpm dev` lee `client/.env` / `client/.env.local` al arrancar el frontend
# - El archivo de la raíz sirve como referencia general; no es el punto de carga por defecto del workspace

# Server
PORT=3000
# Acceso en red local: HOST=0.0.0.0 y ALLOW_LAN=true
HOST=localhost
ALLOW_LAN=false
# Opcional: si lo rellenas se activa la protección por token (recomendado en red pública o compartida); vacío = sin comprobación. El servicio de escritorio lo genera solo.
AI_NOVEL_ACCESS_TOKEN=
CORS_ORIGIN=http://localhost:5173
# Por defecto usa SQLite; para PostgreSQL, descomenta la línea siguiente y rellena la cadena de conexión.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_novel
API_JSON_LIMIT=20mb
# Número de instantáneas automáticas que se conservan por novela; las guardadas a mano no cuentan para este límite.
NOVEL_SNAPSHOT_RETENTION_COUNT=10

# Almacenamiento de imágenes: por defecto, archivos locales. MinIO/S3 solo se usa si eliges s3/minio explícitamente.
# IMAGE_STORAGE_DRIVER=local
# IMAGE_STORAGE_ROOT=storage/generated-images
# IMAGE_STORAGE_DRIVER=minio
# IMAGE_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# IMAGE_STORAGE_S3_REGION=us-east-1
# IMAGE_STORAGE_S3_BUCKET=ai-novel-images
# IMAGE_STORAGE_S3_ACCESS_KEY_ID=
# IMAGE_STORAGE_S3_SECRET_ACCESS_KEY=
# IMAGE_STORAGE_S3_FORCE_PATH_STYLE=true
# Espera máxima de la API de generación de imágenes (ms), por defecto 300000.
# IMAGE_GENERATION_HTTP_TIMEOUT_MS=300000
BOOK_ANALYSIS_LLM_TIMEOUT_MS=90000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
SILICONFLOW_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
XAI_IMAGE_MODEL=grok-imagine-image

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-air

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# RAG / vectores
RAG_ENABLED=true
RAG_VERBOSE_LOG=false
RAG_DEFAULT_TENANT=default
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=1
EMBEDDING_BATCH_SIZE=64
# Qdrant local:
QDRANT_URL=http://127.0.0.1:6333
# Ejemplo de Qdrant Cloud:
# QDRANT_URL=https://your-cluster.us-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_novel_chunks_v1
QDRANT_TIMEOUT_MS=120000
QDRANT_UPSERT_MAX_BYTES=3145728
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_VECTOR_CANDIDATES=40
RAG_KEYWORD_CANDIDATES=40
RAG_FINAL_TOP_K=8
RAG_WORKER_POLL_MS=2500
RAG_WORKER_MAX_ATTEMPTS=5
RAG_WORKER_RETRY_BASE_MS=5000
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BASE_MS=500
RAG_HTTP_TIMEOUT_MS=30000

# Proveedor de vídeo para series cortas
# DRAMA_VIDEO_HTTP_CREATE_URL=
# DRAMA_VIDEO_HTTP_STATUS_URL=
# DRAMA_VIDEO_HTTP_API_KEY=
# DRAMA_VIDEO_HTTP_PROVIDER_ID=http
# DRAMA_VIDEO_HTTP_PROVIDER_LABEL=HTTP canal de vídeo
# DRAMA_VIDEO_HTTP_PROVIDER_DESCRIPTION=Servicio externo de generación de vídeo configurado por variables de entorno.
# DRAMA_VIDEO_HTTP_TIMEOUT_MS=120000
# DRAMA_VIDEO_HTTP_SUPPORTS_REF_IMAGES=false
# DRAMA_VIDEO_REF_IMAGE_BASE_URL=http://localhost:3000
# DRAMA_VIDEO_MOCK_COST_PER_SECOND=0
# DRAMA_VIDEO_HTTP_COST_PER_SECOND=0
# DRAMA_VIDEO_HTTP_COST_CURRENCY=CNY

# Proveedor de TTS para series cortas
# DRAMA_TTS_HTTP_SYNTHESIZE_URL=
# DRAMA_TTS_HTTP_API_KEY=
# DRAMA_TTS_HTTP_PROVIDER_ID=http
# DRAMA_TTS_HTTP_PROVIDER_LABEL=HTTP canal de voz
# DRAMA_TTS_HTTP_PROVIDER_DESCRIPTION=Servicio TTS externo configurado por variables de entorno.
# DRAMA_TTS_HTTP_TIMEOUT_MS=120000
# DRAMA_TTS_MOCK_COST_PER_SECOND=0
# DRAMA_TTS_HTTP_COST_PER_SECOND=0
# DRAMA_TTS_HTTP_COST_CURRENCY=CNY

# Estimación de coste de producción de series cortas
# DRAMA_COST_CURRENCY=CNY
# DRAMA_IMAGE_COST_PER_IMAGE=0
# DRAMA_IMAGE_COST_PER_IMAGE_OPENAI=0

# Cliente
VITE_API_BASE_URL=http://localhost:3000/api
VITE_CREATION_STUDIO_ENABLED=true
